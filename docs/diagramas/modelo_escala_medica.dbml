Table "especialidade" {
  "id_especialidade" int [pk]
  "nome" varchar(50) [unique]
}

Table "regime_trabalho" {
  "id_regime" int [pk]
  "descricao" text [unique]
  "carga_horaria_semanal" int
}

Table "medico" {
  "id_medico" int [pk]
  "nome" varchar(50)
  "crm" text [unique]
  "email" text [unique]
  "data_admissao" varchar(10)
  "id_especialidade" int [not null]
  "id_regime" int
}

Table "predio" {
  "id_predio" int [pk]
  "nome" varchar(50) [unique, not null]
  "endereco" varchar(100) [unique, not null]
}

Table "departamento" {
  "id_departamento" int [pk]
  "nome" varchar(50) [unique, not null]
  "id_predio" int [not null]
}

Table "turno" {
  "id_turno" int [pk]
  "desc" varchar(20) [unique]
}

Table "departamento_especialidade" {
  "id_departamento" int [not null]
  "id_especialidade" int [not null]
  "(id_departamento, id_especialidade)" primary [pk]
}

Table "alocacao" {
  "id_medico" int [not null]
  "id_departamento" int [not null]
  "id_turno" int [not null]
  "dia" int [not null]
  "(id_medico, id_turno, dia)" primary [pk]
}

Ref: "medico"."id_especialidade" > "especialidade"."id_especialidade"
Ref: "medico"."id_regime" > "regime_trabalho"."id_regime"
Ref: "departamento"."id_predio" > "predio"."id_predio"
Ref: "departamento_especialidade"."id_departamento" > "departamento"."id_departamento"
Ref: "departamento_especialidade"."id_especialidade" > "especialidade"."id_especialidade"
Ref: "alocacao"."id_medico" > "medico"."id_medico"
Ref: "alocacao"."id_departamento" > "departamento"."id_departamento"
Ref: "alocacao"."id_turno" > "turno"."id_turno"
